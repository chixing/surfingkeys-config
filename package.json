{
  "name": "surfingkeys-config",
  "version": "1.0.16",
  "description": "TypeScript-based SurfingKeys configuration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "release": "npm run verify && npm version patch -m \"Release %s\" && git push --follow-tags",
    "deploy": "node scripts/release.mjs deploy",
    "deploy:templates": "gh gist edit 82767d49380294ad7b298554e2c0e59b --add templates.json",
    "verify": "npm run lint && npm run type-check && npm run build",
    "package:release": "npm run verify && node scripts/release.mjs pack",
    "verify:release": "node scripts/release.mjs verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^20.11.5",
    "esbuild": "^0.20.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
